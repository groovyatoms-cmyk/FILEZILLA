# Copy to .env.local for local development (Vite loads .env.local automatically, git-ignored).

# WebSocket URL of the signaling server (see apps/signaling).
VITE_SIGNALING_URL=ws://localhost:8787

# Comma-separated STUN server URLs used for WebRTC NAT traversal. Defaults to a public
# Google STUN server if unset.
VITE_STUN_URLS=stun:stun.l.google.com:19302

# Optional TURN server, used only as a fallback when a direct P2P connection can't be
# established and "Allow TURN fallback" is enabled in Settings. Leave unset to disable
# TURN entirely (transfers will fail to connect on restrictive networks without it).
# VITE_TURN_URL=turn:your-turn-server.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
